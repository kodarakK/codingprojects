#include <stdio.h>
#include <string.h>
#include <arpa/inet.h>
#include <unistd.h>
#include <sys/socket.h>

#define PRINTER_IP ""
#define PRINTER_PORT 

int main()
{
	int sock = socket(AF_INET, SOCK_STREAM, 0);
	struct sockaddr_in printer;

	printer.sin_family = AF_INET;
	print.sin_port = htons(PRINTER_PORT);
	inet_pton(AF_INET, PRINTER_IP, &printer.sin_addr);
	if (connect(sock, (struct sockaddr*)&printer, sizeof(printer)) < 0) {
		perror("connection failed");
		return 1;
	}

	const char *data = "Hellorld\n\f";
	send(sock, data, strlen(data), 0);

	close(sock);
	return 0;

}
